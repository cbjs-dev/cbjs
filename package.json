{
  "name": "@cbjsdev/monorepo",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.0.6",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "lerna run --stream build --scope @cbjsdev/*",
    "dev": "lerna run --parallel dev --scope @cbjsdev/*",
    "lint:check": "eslint --quiet packages tests",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "test": "vitest --run",
    "prepare": "husky",
    "clearDatabase": "pnpm -r --filter='./tests/scripts' run clear"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vitest/ui": "5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "glob": "^13.0.6",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lerna": "^10.1.1",
    "pino": "^10.4.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "overrides": {
      "vitepress>@vitejs/plugin-vue": "^6.0.10",
      "vitepress>vite": "^7.3.7"
    }
  }
}

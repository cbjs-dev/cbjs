{
  "name": "@cbjsdev/monorepo",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.0.6",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "lerna run --stream build --scope @cbjsdev/*",
    "dev": "lerna run --parallel dev --scope @cbjsdev/*",
    "lint:check": "eslint --quiet packages tests",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "test": "vitest --run",
    "prepare": "husky",
    "clearDatabase": "pnpm -r --filter='./tests/scripts' run clear"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "4.3.0",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "@vitest/coverage-v8": "4.1.12",
    "@vitest/ui": "4.1.12",
    "esbuild": "^0.28.1",
    "eslint": "^8.44.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-jsdoc": "48.0.5",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-prettier": "5.1.3",
    "eslint-plugin-vitest": "^0.3.9",
    "glob": "^10.5.0",
    "husky": "^9.0.10",
    "lerna": "^9.0.7",
    "pino": "^8.21.0",
    "prettier": "3.2.5",
    "typescript": "5.4.5",
    "vite": "^8.2.0",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "overrides": {
      "@shikijs/vitepress-twoslash>@shikijs/twoslash": "2.5.0",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "minimatch@>=9.0.0 <9.0.7": "^9.0.7",
      "tar@<7.5.18": "^7.5.22",
      "vitepress>vite": "^6.4.4"
    }
  }
}
